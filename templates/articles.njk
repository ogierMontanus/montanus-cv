---
layout: _includes/base.njk
---
<h2>Articles and Chapters</h2>

{% set articles = publications | filterByType("journal-article", "book-chapter", "dissertation") | filterByFlag("include_on_site") | sortByYear %}

{% if articles.length == 0 %}
<p class="placeholder-note">
  Publication list is populated from ORCID. Run <code>python3 scripts/sync_orcid.py</code>
  locally to fetch the full list, then commit <code>data/publications.yaml</code>.
</p>
{% endif %}

{% set decades = articles | groupByDecade %}
{% for decade, items in decades %}
<section class="decade-group">
  <h3>{{ decade }}</h3>
  <ul class="pub-list">
    {% for pub in items %}
    <li class="pub-item">
      <p class="pub-title">
        <span class="pub-year">{{ pub.year }}</span>
        {% if pub.doi %}<a href="https://doi.org/{{ pub.doi }}" target="_blank" rel="noopener"><em>{{ pub.title }}</em></a>
        {% else %}<em>{{ pub.title }}</em>{% endif %}
      </p>
      {% if pub.container_title or pub.place or pub.publisher or pub.pages %}
      <p class="pub-venue">
        {%- if pub.container_title %}in: <em>{{ pub.container_title }}</em>{% if pub.editors %}. Ed. by {{ pub.editors | join(", ") }}{% endif %}{% endif -%}
        {%- if pub.place %}{% if pub.container_title %}. {% endif %}{{ pub.place }}{% if pub.year %} {{ pub.year }}{% endif %}{% endif -%}
        {%- if pub.publisher %}, {{ pub.publisher }}{% endif -%}
        {%- if pub.pages %}, pp. {{ pub.pages }}{% endif -%}
        {%- if pub.note %} ({{ pub.note }}){% endif -%}
      </p>
      {% endif %}
      {% if pub.status %}<p class="status-note">{{ pub.status }}</p>{% endif %}
      {% if pub.contributors %}
      <p class="pub-contributors">{{ pub.contributors | join(", ") }}</p>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}

<p class="orcid-link">
  Full bibliography on
  <a href="https://orcid.org/0000-0002-8496-7221" target="_blank" rel="noopener">ORCID</a>.
</p>

{% set editorialTexts = publications | filterBySection("editorial-texts") | sortByYear %}
{% if editorialTexts.length > 0 %}
<section class="editorial-texts">
  <h3>Editorial texts in scholarly editions</h3>
  <p class="editorial-texts-intro">
    Individual text-critical editions of works by N.F.S. Grundtvig, published 2011–2020 as
    part of the digital edition <em>Grundtvigs Værker</em> (see
    <a href="{{ '/editions/' | url }}">Editions</a> for the project as a whole).
  </p>
  <ul class="editorial-list">
    {% for pub in editorialTexts %}
    <li><span class="pub-year">{{ pub.year }}</span> {{ pub.title }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}
