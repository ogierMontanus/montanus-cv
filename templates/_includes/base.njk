<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}Holger Berg, historian</title>
  <meta name="description" content="Academic website of Holger Berg (Nils Holger Nemeth Berg), historian at the University of Southern Denmark.">
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="site-header">
    <div class="header-inner">
      <p class="site-title">
        <a href="{{ '/' | url }}">Holger Berg<span class="site-title-sub">, historian</span></a>
      </p>

      <input type="checkbox" id="nav-toggle" class="nav-toggle-input">
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation menu">
        <span></span><span></span><span></span>
      </label>

      <nav class="site-nav" aria-label="Primary">
        <ul>
          <li><a href="{{ '/' | url }}"{% if page.url == "/" %} aria-current="page"{% endif %}>Home</a></li>
          <li><a href="{{ '/books/' | url }}"{% if page.url == "/books/" %} aria-current="page"{% endif %}>Books</a></li>
          <li><a href="{{ '/articles/' | url }}"{% if page.url == "/articles/" %} aria-current="page"{% endif %}>Articles</a></li>
          <li><a href="{{ '/editions/' | url }}"{% if page.url == "/editions/" %} aria-current="page"{% endif %}>Editions</a></li>
          <li><a href="{{ '/museum-work/' | url }}"{% if page.url == "/museum-work/" %} aria-current="page"{% endif %}>Museum work</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <div class="page-layout">
    <main class="main-content" id="main-content">
      {{ content | safe }}
    </main>

    <aside class="sidebar" aria-label="Related links">
      <section class="sidebar-block">
        <h3>Profile</h3>
        <ul>
          <li><a href="https://orcid.org/0000-0002-8496-7221" target="_blank" rel="noopener">ORCID profile ↗</a></li>
          <li><a href="https://portal.findresearcher.sdu.dk/da/persons/nh" target="_blank" rel="noopener">SDU research portal ↗</a></li>
        </ul>
      </section>
    </aside>
  </div>

  <footer class="site-footer">
    <p>Holger Berg · University of Southern Denmark ·
       <a href="mailto:nh@sdu.dk">nh@sdu.dk</a></p>
  </footer>
</body>
</html>
